# Vor Veröffentlichung auf dem tatsächlichen IONOS-Hosting prüfen.
Options -Indexes
DirectoryIndex index.html
RewriteEngine On
# Die App-Verzeichnisse liegen innerhalb dieses Dokumentenverzeichnisses.
# Direkte Hauptdomain-Unterpfade auf die passenden App-Hosts umleiten.
RewriteCond %{HTTP_HOST} ^(?:www\.)?if3t\.de$ [NC]
RewriteRule ^sonnenstand-app(?:/(.*))?$ https://sonnenstand-app.if3t.de/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?if3t\.de$ [NC]
RewriteRule ^sektoren-app(?:/(.*))?$ https://sektoren-app.if3t.de/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^if3t\.de$ [NC]
RewriteRule ^ https://www.if3t.de%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.if3t\.de$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.if3t.de%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
Header set Cache-Control "no-cache"
<FilesMatch "\.(css|js|svg)$">
Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
